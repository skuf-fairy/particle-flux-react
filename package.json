{
  "name": "particle-flux-react",
  "version": "0.1.0",
  "description": "Canvas particle emitter for React with a universal hook for custom rendering adapters.",
  "author": "skuf-fairy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skuf-fairy/particle-flux-react.git"
  },
  "homepage": "https://github.com/skuf-fairy/particle-flux-react#readme",
  "bugs": {
    "url": "https://github.com/skuf-fairy/particle-flux-react/issues"
  },
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "vite --host 127.0.0.1",
    "demo:build": "vite build",
    "demo:preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.demo.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run typecheck && npm test && npm run test:package"
  },
  "keywords": [
    "react",
    "particles",
    "particle-flux",
    "emitter",
    "animation",
    "canvas",
    "react-hook"
  ],
  "dependencies": {
    "particle-flux": "2.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
